+		}
+		cc.mu.Lock()
+		cc.certs[key] = kp
+		cc.mu.Unlock()
+		return kp, nil
+	})
+	if err != nil {
+		errors.LogWarningInner(context.Background(), err, "failed to issue client certificate")
+		return nil
+	}
+	return v.(*tls.Certificate)
