+    private fun pickMtlsFile(state: ServerUiState, entryId: String, kind: String) {
+        val entry = state.mtlsCertificates.firstOrNull { it.id == entryId } ?: return
+        val isKeyFile = kind == MtlsCertificateManager.KIND_KEY
+        val requireCa = !isKeyFile && entry.usage == MtlsCertificateManager.USAGE_CLIENT_AUTHORITY
