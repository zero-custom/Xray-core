+                // Import/validate off the main thread: PEM files can be a few hundred KB.
+                val imported = withContext(Dispatchers.IO) {
+                    MtlsCertificateManager.importFile(this@BaseServerActivity, uri)
+                }
+                if (imported == null) {
+                    toast(R.string.mtls_error_copy_failed)
+                    return@launch
+                }
