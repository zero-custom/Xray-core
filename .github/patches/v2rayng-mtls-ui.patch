+import com.v2ray.ang.R
+import com.v2ray.ang.dto.entities.MtlsCertificateEntry
+import com.v2ray.ang.ui.server.MtlsCertificatesSection
+
+/**
+ * Subscription-level mTLS configuration: the certificate list shared by the
+ * subscription fetch and the imported TLS nodes, plus an optional CA used only
+ * to verify the subscription server.
+ *
+ * Uses a plain [Column] because the subscription editor already scrolls.
+ */
+@Composable
+fun SubscriptionMtlsSection(
+    enabled: Boolean,
+    entries: MutableList<MtlsCertificateEntry>,
+    serverCaPath: String,
+    serverCaName: String,
+    onEnabledChange: (Boolean) -> Unit,
+    onPickFile: (entryId: String, kind: String) -> Unit,
+    onDelete: (entryId: String) -> Unit,
+    onPickServerCa: () -> Unit,
+    onClearServerCa: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(
+        modifier = modifier.fillMaxWidth(),
+        verticalArrangement = Arrangement.spacedBy(8.dp)
+    ) {
+        MtlsCertificatesSection(
+            enabled = enabled,
+            entries = entries,
+            onEnabledChange = onEnabledChange,
+            onPickFile = onPickFile,
+            onDelete = onDelete,
+            title = stringResource(R.string.sub_mtls_enabled),
+            summary = stringResource(R.string.sub_mtls_enabled_summary)
+        )
+
+        if (enabled) {
+            Card(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 16.dp)
+            ) {
+                Column(
+                    modifier = Modifier.padding(12.dp),
+                    verticalArrangement = Arrangement.spacedBy(4.dp)
+                ) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Text(
+                            text = stringResource(R.string.sub_mtls_server_ca),
+                            style = MaterialTheme.typography.titleSmall,
+                            modifier = Modifier.weight(1f)
+                        )
+                        if (serverCaPath.isNotBlank()) {
+                            TextButton(onClick = onClearServerCa) {
+                                Text(stringResource(R.string.sub_mtls_server_ca_clear))
+                            }
+                        }
+                    }
+                    Row(
+                        modifier = Modifier.fillMaxWidth(),
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        Text(
+                            text = if (serverCaPath.isBlank()) {
+                                stringResource(R.string.sub_mtls_server_ca_empty)
+                            } else {
+                                serverCaName
+                            },
+                            style = MaterialTheme.typography.bodySmall,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis,
+                            modifier = Modifier.weight(1f)
+                        )
+                        TextButton(onClick = onPickServerCa) {
+                            Text(stringResource(R.string.sub_mtls_server_ca_select))
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
