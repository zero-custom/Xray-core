+package com.v2ray.ang.dto.entities
+
+/**
+ * A single mTLS client certificate entry stored on a [ProfileItem].
+ *
+ * [usage] mirrors the core field `tlsSettings.certificates[].usage`:
+ * - `client`             static client certificate (`certificateFile` + `keyFile`)
+ * - `client_authority`   CA certificate + CA private key used to dynamically issue
+ *                        client certificates.
+ *
+ * Paths are absolute paths inside the app private directory; see
+ * `MtlsCertificateManager` for how imported files are stored.
+ */
+data class MtlsCertificateEntry(
+    var id: String = "",
+    var usage: String = "client",
+    var certPath: String = "",
+    var keyPath: String = "",
+    var certName: String = "",
+    var keyName: String = "",
+) {
+    fun isComplete(): Boolean = certPath.isNotBlank() && keyPath.isNotBlank()
+}
