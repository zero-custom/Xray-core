+package com.v2ray.ang.handler
+
+import com.v2ray.ang.AppConfig
+import com.v2ray.ang.dto.entities.MtlsCertificateEntry
+import com.v2ray.ang.dto.entities.ProfileItem
+import com.v2ray.ang.dto.entities.SubscriptionItem
+import com.v2ray.ang.enums.EConfigType
+import com.v2ray.ang.util.JsonUtil
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class SubscriptionMtlsTest {
+
+    private fun entry(
+        usage: String = MtlsCertificateManager.USAGE_CLIENT,
+        complete: Boolean = true,
+    ) = MtlsCertificateEntry(
+        id = "entry-1",
+        usage = usage,
+        certPath = if (complete) "/tmp/client.crt" else "",
+        keyPath = if (complete) "/tmp/client.key" else "",
+        certName = "client.crt",
+        keyName = "client.key",
+    )
+
+    private fun profile(security: String?, type: EConfigType = EConfigType.VLESS) =
+        ProfileItem(configType = type, security = security)
+
+    private fun subscription(
+        enabled: Boolean = true,
+        entries: List<MtlsCertificateEntry>? = listOf(entry()),
+    ) = SubscriptionItem(mtlsEnabled = enabled, mtlsCertificates = entries)
+
+    @Test
+    fun tlsProfileInheritsSubscriptionCertificates() {
+        val result = AngConfigManager.applySubscriptionMtls(profile(AppConfig.TLS), subscription())
+
+        assertTrue(result.mtlsEnabled)
+        val certificates = result.mtlsCertificates.orEmpty()
+        assertEquals(1, certificates.size)
+        assertEquals(MtlsCertificateManager.USAGE_CLIENT, certificates[0].usage)
+        assertEquals("/tmp/client.crt", certificates[0].certPath)
+        assertTrue(certificates[0].id.isNotBlank())
+    }
+
+    @Test
+    fun realityProfileIsUntouched() {
+        val result = AngConfigManager.applySubscriptionMtls(profile(AppConfig.REALITY), subscription())
+
+        assertFalse(result.mtlsEnabled)
+        assertNull(result.mtlsCertificates)
+    }
+
+    @Test
+    fun nonTlsProfileIsUntouched() {
+        val result = AngConfigManager.applySubscriptionMtls(profile(null), subscription())
+
+        assertFalse(result.mtlsEnabled)
+        assertNull(result.mtlsCertificates)
+    }
+
+    @Test
+    fun customProfileIsUntouched() {
+        val result = AngConfigManager.applySubscriptionMtls(
+            profile(AppConfig.TLS, EConfigType.CUSTOM),
+            subscription()
+        )
+
+        assertFalse(result.mtlsEnabled)
+        assertNull(result.mtlsCertificates)
+    }
+
+    @Test
+    fun disabledSubscriptionDoesNotInject() {
+        val result = AngConfigManager.applySubscriptionMtls(
+            profile(AppConfig.TLS),
+            subscription(enabled = false)
+        )
+
+        assertFalse(result.mtlsEnabled)
+        assertNull(result.mtlsCertificates)
+    }
+
+    @Test
+    fun incompleteEntriesAreFilteredOut() {
+        val result = AngConfigManager.applySubscriptionMtls(
+            profile(AppConfig.TLS),
+            subscription(entries = listOf(entry(complete = false)))
+        )
+
+        assertFalse(result.mtlsEnabled)
+        assertNull(result.mtlsCertificates)
+    }
+
+    @Test
+    fun bothUsagesArePreserved() {
+        val result = AngConfigManager.applySubscriptionMtls(
+            profile(AppConfig.TLS),
+            subscription(
+                entries = listOf(
+                    entry(),
+                    entry(usage = MtlsCertificateManager.USAGE_CLIENT_AUTHORITY),
+                )
+            )
+        )
+
+        val usages = result.mtlsCertificates.orEmpty().map { it.usage }
+        assertEquals(
+            listOf(
+                MtlsCertificateManager.USAGE_CLIENT,
+                MtlsCertificateManager.USAGE_CLIENT_AUTHORITY,
+            ),
+            usages
+        )
+    }
+
+    @Test
+    fun subscriptionItemRoundTripsThroughGson() {
+        val item = SubscriptionItem(
+            mtlsEnabled = true,
+            mtlsCertificates = listOf(entry()),
+            serverCaPath = "/tmp/server-ca.pem",
+            serverCaName = "server-ca.pem",
+        )
+
+        val restored = requireNotNull(
+            JsonUtil.fromJson(JsonUtil.toJson(item), SubscriptionItem::class.java)
+        )
+
+        assertTrue(restored.mtlsEnabled)
+        assertEquals(1, restored.mtlsCertificates?.size)
+        assertEquals("/tmp/server-ca.pem", restored.serverCaPath)
+        assertEquals("server-ca.pem", restored.serverCaName)
+    }
+
+    @Test
+    fun legacySubscriptionWithoutNewFieldsKeepsDefaults() {
+        val restored = requireNotNull(
+            JsonUtil.fromJson(
+                """{"remarks":"legacy","url":"https://example.com/sub"}""",
+                SubscriptionItem::class.java
+            )
+        )
+
+        assertFalse(restored.mtlsEnabled)
+        assertNull(restored.mtlsCertificates)
+        assertNull(restored.serverCaPath)
+    }
+}
