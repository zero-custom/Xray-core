+package com.v2ray.ang.util
+
+import com.v2ray.ang.handler.MtlsCertificateManager
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.security.KeyFactory
+import java.security.KeyPairGenerator
+import java.security.interfaces.RSAPrivateKey
+import java.security.spec.PKCS8EncodedKeySpec
+
+class MtlsSslContextFactoryTest {
+
+    @Test
+    fun wrapsPkcs1RsaKeyIntoParseablePkcs8() {
+        val keyPair = KeyPairGenerator.getInstance("RSA").apply { initialize(2048) }.generateKeyPair()
+        val pkcs8 = keyPair.private.encoded
+        val pkcs1 = extractPkcs1(pkcs8)
+
+        val wrapped = MtlsCertificateManager.wrapPkcs1RsaAsPkcs8(pkcs1)
+
+        val parsed = KeyFactory.getInstance("RSA")
+            .generatePrivate(PKCS8EncodedKeySpec(wrapped)) as RSAPrivateKey
+        assertEquals(keyPair.private as RSAPrivateKey, parsed)
+    }
+
+    @Test
+    fun acceptsSameHostHttpsTarget() {
+        assertTrue(HttpUtil.isOriginalTlsTarget("https://example.com/sub", "example.com"))
+        assertTrue(HttpUtil.isOriginalTlsTarget("https://EXAMPLE.com/sub", "example.com"))
+    }
+
+    @Test
+    fun rejectsCrossHostRedirect() {
+        assertFalse(HttpUtil.isOriginalTlsTarget("https://cdn.example.net/sub", "example.com"))
+    }
+
+    @Test
+    fun rejectsNonHttpsTarget() {
+        assertFalse(HttpUtil.isOriginalTlsTarget("http://example.com/sub", "example.com"))
+    }
+
+    @Test
+    fun rejectsMissingHostOrUrl() {
+        assertFalse(HttpUtil.isOriginalTlsTarget(null, "example.com"))
+        assertFalse(HttpUtil.isOriginalTlsTarget("https://example.com/sub", null))
+        assertFalse(HttpUtil.isOriginalTlsTarget("not a url", "example.com"))
+    }
+
+    private fun extractPkcs1(pkcs8: ByteArray): ByteArray {
+        assertEquals(0x30, pkcs8[0].toInt() and 0xff)
+        var offset = 1
+        val (_, outerLengthSize) = readLength(pkcs8, offset)
+        offset += outerLengthSize
+
+        offset = skipElement(pkcs8, offset)
+        offset = skipElement(pkcs8, offset)
+
+        val tag = pkcs8[offset].toInt() and 0xff
+        assertEquals(0x04, tag)
+        val (length, lengthSize) = readLength(pkcs8, offset + 1)
+        val start = offset + 1 + lengthSize
+        return pkcs8.copyOfRange(start, start + length)
+    }
+
+    private fun skipElement(data: ByteArray, offset: Int): Int {
+        val (length, lengthSize) = readLength(data, offset + 1)
+        return offset + 1 + lengthSize + length
+    }
+
+    private fun readLength(data: ByteArray, offset: Int): Pair<Int, Int> {
+        val first = data[offset].toInt() and 0xff
+        if (first < 0x80) return first to 1
+        val count = first and 0x7f
+        var value = 0
+        for (index in 1..count) {
+            value = (value shl 8) or (data[offset + index].toInt() and 0xff)
+        }
+        return value to (1 + count)
+    }
+}
