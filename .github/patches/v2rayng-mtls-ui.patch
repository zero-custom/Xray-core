index 0000000..456967e
--- /dev/null
+++ b/V2rayNG/app/src/main/java/com/v2ray/ang/util/MtlsSslContextFactory.kt
@@ -0,0 +1,164 @@
+package com.v2ray.ang.util
+
+import com.v2ray.ang.handler.MtlsCertificateManager
+import java.io.IOException
+import java.security.KeyFactory
+import java.security.KeyStore
+import java.security.PrivateKey
+import java.security.cert.Certificate
+import java.security.spec.PKCS8EncodedKeySpec
+import javax.net.ssl.KeyManager
+import javax.net.ssl.KeyManagerFactory
+import javax.net.ssl.SSLContext
+import javax.net.ssl.SSLSocketFactory
+import javax.net.ssl.TrustManager
+import javax.net.ssl.TrustManagerFactory
+import javax.net.ssl.X509TrustManager
+
+/**
+ * TLS material used by the subscription HTTP client.
+ *
+ * [trustManager] must be passed together with [socketFactory] so OkHttp keeps
+ * validating the server against the same trust anchors.
+ */
+data class TlsClientContext(
+    val socketFactory: SSLSocketFactory,
+    val trustManager: X509TrustManager,
+)
+
+/**
+ * Builds an [SSLContext] with an optional client certificate and/or a custom
+ * server CA bundle. Certificate and private-key contents never leave memory and
+ * are never logged.
+ */
+object MtlsSslContextFactory {
+
+    /**
+     * @return `null` when no option is set; otherwise a context configured with
+     *         the requested client identity and/or server trust anchors.
+     * @throws IOException when a required file is missing, unreadable or
+     *         unsupported. Callers must not fall back to an unauthenticated
+     *         request after this happens.
+     */
+    fun create(
+        clientCertPath: String?,
+        clientKeyPath: String?,
+        serverCaPath: String?,
+    ): TlsClientContext? {
+        val hasCert = !clientCertPath.isNullOrBlank()
+        val hasKey = !clientKeyPath.isNullOrBlank()
+        val hasServerCa = !serverCaPath.isNullOrBlank()
+        if (!hasCert && !hasKey && !hasServerCa) return null
+        if (hasCert != hasKey) {
+            throw IOException("client certificate and key must be provided together")
+        }
+
+        val trustManager = if (hasServerCa) {
+            buildTrustManager(serverCaPath!!)
+        } else {
+            defaultTrustManager()
+        }
+        val keyManagers = if (hasCert) {
+            buildKeyManagers(clientCertPath!!, clientKeyPath!!)
+        } else {
+            null
+        }
+
+        return try {
+            val context = SSLContext.getInstance("TLS")
+            context.init(keyManagers, arrayOf<TrustManager>(trustManager), null)
+            TlsClientContext(context.socketFactory, trustManager)
+        } catch (e: Exception) {
+            throw IOException("cannot initialise TLS context: ${e.message}", e)
+        }
+    }
+
+    private fun defaultTrustManager(): X509TrustManager {
+        return try {
+            val factory = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm())
+            factory.init(null as KeyStore?)
+            factory.trustManagers.filterIsInstance<X509TrustManager>().firstOrNull()
+                ?: throw IOException("no default X509 trust manager available")
+        } catch (e: IOException) {
+            throw e
+        } catch (e: Exception) {
+            throw IOException("cannot initialise the default trust manager: ${e.message}", e)
+        }
+    }
+
+    private fun buildTrustManager(serverCaPath: String): X509TrustManager {
+        val certificates = MtlsCertificateManager.loadCertificates(serverCaPath)
+        if (certificates.isEmpty()) {
+            throw IOException("server CA file is empty or not a certificate bundle")
+        }
+        return try {
+            val keyStore = KeyStore.getInstance(KeyStore.getDefaultType())
+            keyStore.load(null, null)
+            certificates.forEachIndexed { index, certificate ->
+                keyStore.setCertificateEntry("ca-$index", certificate)
+            }
+            val factory = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm())
+            factory.init(keyStore)
+            factory.trustManagers.filterIsInstance<X509TrustManager>().firstOrNull()
+                ?: throw IOException("no X509 trust manager available")
+        } catch (e: IOException) {
+            throw e
+        } catch (e: Exception) {
+            throw IOException("cannot load the server CA bundle: ${e.message}", e)
+        }
+    }
+
+    private fun buildKeyManagers(clientCertPath: String, clientKeyPath: String): Array<KeyManager> {
+        val chain = MtlsCertificateManager.loadCertificates(clientCertPath)
+        if (chain.isEmpty()) {
+            throw IOException("client certificate is empty or unreadable")
+        }
+        val text = MtlsCertificateManager.readPemText(clientKeyPath)
+            ?: throw IOException("client private key is empty or unreadable")
+        val privateKey = parsePrivateKey(text, chain.first().publicKey.algorithm)
+
+        return try {
+            val password = charArrayOf()
+            val keyStore = KeyStore.getInstance(KeyStore.getDefaultType())
+            keyStore.load(null, null)
+            val certificateChain = Array<Certificate>(chain.size) { index -> chain[index] }
+            keyStore.setKeyEntry("client", privateKey, password, certificateChain)
+            val factory = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm())
+            factory.init(keyStore, password)
+            factory.keyManagers
+        } catch (e: Exception) {
+            throw IOException("cannot load the client certificate: ${e.message}", e)
+        }
+    }
+
+    internal fun parsePrivateKey(text: String, certificateAlgorithm: String): PrivateKey {
+        if (MtlsCertificateManager.isUnsupportedPrivateKey(text)) {
+            throw IOException("encrypted and SEC1 EC private keys are not supported")
+        }
+        val pkcs1 = MtlsCertificateManager.readPemBlocksFromText(text, listOf("RSA PRIVATE KEY"))
+            .firstOrNull()
+        if (pkcs1 != null) {
+            if (!certificateAlgorithm.equals("RSA", ignoreCase = true)) {
+                throw IOException("RSA private key does not match the certificate")
+            }
+            return generatePrivate("RSA", MtlsCertificateManager.wrapPkcs1RsaAsPkcs8(pkcs1))
+        }
+        val pkcs8 = MtlsCertificateManager.readPemBlocksFromText(text, listOf("PRIVATE KEY"))
+            .firstOrNull()
+            ?: throw IOException("no supported private key found")
+        val algorithm = when (certificateAlgorithm.uppercase()) {
+            "RSA" -> "RSA"
+            "EC" -> "EC"
+            else -> throw IOException("unsupported certificate key algorithm: $certificateAlgorithm")
+        }
+        return generatePrivate(algorithm, pkcs8)
+    }
+
+    private fun generatePrivate(algorithm: String, der: ByteArray): PrivateKey {
+        return try {
+            KeyFactory.getInstance(algorithm).generatePrivate(PKCS8EncodedKeySpec(der))
+        } catch (e: Exception) {
+            throw IOException("cannot parse the private key: ${e.message}", e)
+        }
+    }
+}
