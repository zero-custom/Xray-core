+import java.util.UUID
+
+/**
+ * Generic mTLS certificate editor. Used by the server editor and by the
+ * subscription editor, which keep their entries in different state holders.
+ *
+ * Uses a plain [Column] (never a [androidx.compose.foundation.lazy.LazyColumn])
+ * because the surrounding editor already scrolls vertically.
+ */
+@Composable
+fun MtlsCertificatesSection(
+    enabled: Boolean,
+    entries: MutableList<MtlsCertificateEntry>,
+    onEnabledChange: (Boolean) -> Unit,
+    onPickFile: (entryId: String, kind: String) -> Unit,
+    onDelete: (entryId: String) -> Unit,
+    modifier: Modifier = Modifier,
+    title: String? = null,
+    summary: String? = null,
+) {
+    Column(
+        modifier = modifier.fillMaxWidth(),
+        verticalArrangement = Arrangement.spacedBy(8.dp)
+    ) {
+        SettingsSwitchItem(
+            title = title ?: stringResource(R.string.mtls_enabled),
+            summary = summary ?: stringResource(R.string.mtls_enabled_summary),
+            checked = enabled,
+            onCheckedChange = onEnabledChange
+        )
+
+        if (enabled) {
+            if (entries.isEmpty()) {
+                Text(
+                    text = stringResource(R.string.mtls_empty),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(horizontal = 16.dp)
+                )
+            }
+
+            entries.forEachIndexed { index, entry ->
+                MtlsCertificateCard(
+                    entry = entry,
+                    index = index,
+                    onUsageChange = { usage ->
+                        entries[index] = entry.copy(usage = usage)
+                    },
+                    onPickFile = onPickFile,
+                    onDelete = onDelete
+                )
+            }
+
+            OutlinedButton(
+                onClick = {
+                    entries.add(
+                        MtlsCertificateEntry(
+                            id = UUID.randomUUID().toString(),
+                            usage = MtlsCertificateManager.USAGE_CLIENT
+                        )
+                    )
+                },
+                modifier = Modifier.padding(horizontal = 16.dp)
+            ) {
+                Text(stringResource(R.string.mtls_add))
+            }
+        }
+    }
+}
+
+@Composable
+fun MtlsCertificatesSection(
+    state: ServerUiState,
+    onPickFile: (entryId: String, kind: String) -> Unit,
+    onDelete: (entryId: String) -> Unit,
+    modifier: Modifier = Modifier,
+) = MtlsCertificatesSection(
+    enabled = state.mtlsEnabled,
+    entries = state.mtlsCertificates,
+    onEnabledChange = { state.mtlsEnabled = it },
+    onPickFile = onPickFile,
+    onDelete = onDelete,
+    modifier = modifier,
+)
+
+@Composable
+private fun MtlsCertificateCard(
+    entry: MtlsCertificateEntry,
+    index: Int,
+    onUsageChange: (String) -> Unit,
+    onPickFile: (entryId: String, kind: String) -> Unit,
+    onDelete: (entryId: String) -> Unit,
+) {
+    Card(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(horizontal = 16.dp)
+    ) {
+        Column(
+            modifier = Modifier.padding(12.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(
+                    text = stringResource(R.string.mtls_entry_title, index + 1),
+                    style = MaterialTheme.typography.titleSmall,
+                    modifier = Modifier.weight(1f)
+                )
+                TextButton(onClick = { onDelete(entry.id) }) {
+                    Text(stringResource(R.string.mtls_delete))
+                }
+            }
+
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                RadioButton(
+                    selected = entry.usage != MtlsCertificateManager.USAGE_CLIENT_AUTHORITY,
+                    onClick = { onUsageChange(MtlsCertificateManager.USAGE_CLIENT) }
+                )
+                Text(stringResource(R.string.mtls_usage_client))
+                Spacer(Modifier.width(8.dp))
+                RadioButton(
+                    selected = entry.usage == MtlsCertificateManager.USAGE_CLIENT_AUTHORITY,
+                    onClick = { onUsageChange(MtlsCertificateManager.USAGE_CLIENT_AUTHORITY) }
+                )
+                Text(
+                    text = stringResource(R.string.mtls_usage_client_authority),
+                    modifier = Modifier.weight(1f)
+                )
+            }
+
+            MtlsFileRow(
+                label = stringResource(R.string.mtls_cert),
+                fileName = entry.certName,
+                onClick = { onPickFile(entry.id, MtlsCertificateManager.KIND_CERT) }
+            )
+            MtlsFileRow(
+                label = stringResource(R.string.mtls_key),
+                fileName = entry.keyName,
+                onClick = { onPickFile(entry.id, MtlsCertificateManager.KIND_KEY) }
+            )
+        }
+    }
+}
+
+@Composable
+internal fun MtlsFileRow(
+    label: String,
+    fileName: String,
+    onClick: () -> Unit,
+) {
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable(onClick = onClick),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                text = label,
+                style = MaterialTheme.typography.labelMedium
+            )
+            Text(
+                text = fileName,
+                style = MaterialTheme.typography.bodySmall,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis
+            )
+        }
+        TextButton(onClick = onClick) {
+            Text(stringResource(R.string.mtls_select))
+        }
+    }
+}
