index 0000000..78f9a53
--- /dev/null
+++ b/V2rayNG/app/src/main/java/com/v2ray/ang/handler/MtlsCertificateManager.kt
@@ -0,0 +1,296 @@
+package com.v2ray.ang.handler
+
+import android.content.Context
+import android.net.Uri
+import android.provider.OpenableColumns
+import android.util.Base64
+import com.v2ray.ang.util.Utils
+import java.io.ByteArrayInputStream
+import java.io.File
+import java.security.KeyFactory
+import java.security.cert.CertificateFactory
+import java.security.cert.X509Certificate
+import java.security.spec.PKCS8EncodedKeySpec
+import java.util.UUID
+
+/**
+ * Imports and manages mTLS certificate files for the server and subscription editors.
+ *
+ * Files are copied into the app private directory
+ * (`Utils.userAssetPath(context)/mtls`) so that the persisted absolute paths stay
+ * readable after the SAF permission grant is gone.
+ */
+object MtlsCertificateManager {
+    const val USAGE_CLIENT = "client"
+    const val USAGE_CLIENT_AUTHORITY = "client_authority"
+
+    /** Which field of an [com.v2ray.ang.dto.entities.MtlsCertificateEntry] a file belongs to. */
+    const val KIND_CERT = "cert"
+    const val KIND_KEY = "key"
+
+    data class ImportedFile(val path: String, val displayName: String)
+
+    private val unsafeNameChars = Regex("[^A-Za-z0-9._-]")
+
+    /**
+     * Copy the file selected by [uri] into the app private mTLS directory.
+     *
+     * @return the absolute destination path plus the original display name, or
+     *         `null` when the file cannot be copied.
+     */
+    fun importFile(context: Context, uri: Uri): ImportedFile? {
+        val displayName = queryDisplayName(context, uri)
+            ?: uri.lastPathSegment?.substringAfterLast('/')
+            ?: ""
+        val safeName = sanitizeFileName(displayName)
+
+        val baseDir = Utils.userAssetPath(context)
+        if (baseDir.isBlank()) return null
+        val dir = File(baseDir, "mtls")
+        if (!dir.isDirectory && !dir.mkdirs()) return null
+        if (!dir.isDirectory) return null
+
+        val destination = File(dir, "${UUID.randomUUID()}-$safeName")
+        return try {
+            val input = context.contentResolver.openInputStream(uri) ?: return null
+            input.use { source ->
+                destination.outputStream().use { output ->
+                    source.copyTo(output)
+                }
+            }
+            if (destination.length() <= 0L) {
+                destination.delete()
+                null
+            } else {
+                ImportedFile(destination.absolutePath, displayName.ifBlank { safeName })
+            }
+        } catch (e: Exception) {
+            destination.delete()
+            null
+        }
+    }
+
+    /**
+     * Delete a previously imported file, but only when it lives directly under
+     * the app private mTLS directory. Any error is ignored.
+     */
+    fun deleteQuietly(context: Context, path: String) {
+        if (path.isBlank()) return
+        try {
+            val baseDir = Utils.userAssetPath(context)
+            if (baseDir.isBlank()) return
+            val mtlsDir = File(baseDir, "mtls").canonicalFile
+            val target = File(path).canonicalFile
+            if (target.parentFile == mtlsDir && target.exists()) {
+                target.delete()
+            }
+        } catch (e: Exception) {
+            // Best effort: never let cleanup break the editor.
+        }
+    }
+
+    /**
+     * A file is usable when the path is non-blank, points to a regular file and
+     * the file is not empty.
+     */
+    fun isValidFile(path: String): Boolean {
+        if (path.isBlank()) return false
+        return try {
+            val file = File(path)
+            file.isFile && file.length() > 0L
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /**
+     * Best-effort PEM validation for a certificate file. When [requireCa] is
+     * true the certificate must carry the CA basic constraint.
+     */
+    fun validateCertificate(path: String, requireCa: Boolean): Boolean {
+        val der = readPem(path, CERTIFICATE_BLOCKS) ?: return false
+        return try {
+            val certificate = CertificateFactory.getInstance("X.509")
+                .generateCertificate(ByteArrayInputStream(der)) as? X509Certificate
+                ?: return false
+            !requireCa || certificate.basicConstraints >= 0
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /**
+     * Best-effort PEM validation for a private key. PKCS#8 and the classic
+     * PKCS#1/EC armored forms are accepted; the core performs the real parse.
+     */
+    fun validatePrivateKey(path: String): Boolean = readPem(path, PRIVATE_KEY_BLOCKS) != null
+
+    /**
+     * Read every PEM block whose label is in [labels], in file order. A CA bundle
+     * may contain several `CERTIFICATE` blocks; missing or unreadable files
+     * yield an empty list.
+     */
+    fun readPemBlocks(path: String, labels: List<String>): List<ByteArray> {
+        val text = readPemText(path) ?: return emptyList()
+        return readPemBlocksFromText(text, labels)
+    }
+
+    internal fun readPemBlocksFromText(text: String, labels: List<String>): List<ByteArray> {
+        val blocks = mutableListOf<ByteArray>()
+        for (label in labels) {
+            val begin = "-----BEGIN $label-----"
+            val end = "-----END $label-----"
+            var searchFrom = 0
+            while (true) {
+                val start = text.indexOf(begin, searchFrom)
+                if (start < 0) break
+                val contentStart = start + begin.length
+                val stop = text.indexOf(end, contentStart)
+                if (stop < 0) break
+                searchFrom = stop + end.length
+                val body = text.substring(contentStart, stop).replace(Regex("\\s"), "")
+                val decoded = try {
+                    Base64.decode(body, Base64.DEFAULT)
+                } catch (e: Exception) {
+                    null
+                }
+                if (decoded != null && decoded.isNotEmpty()) {
+                    blocks.add(decoded)
+                }
+            }
+        }
+        return blocks
+    }
+
+    internal fun readPemText(path: String): String? {
+        if (path.isBlank()) return null
+        return try {
+            val file = File(path)
+            if (!file.isFile || file.length() <= 0L || file.length() > MAX_PEM_BYTES) return null
+            file.readText()
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    /** Parse every `CERTIFICATE` block of [path] as an X.509 certificate. */
+    fun loadCertificates(path: String): List<X509Certificate> {
+        val certificateFactory = CertificateFactory.getInstance("X.509")
+        return readPemBlocks(path, CERTIFICATE_BLOCKS).mapNotNull { der ->
+            try {
+                certificateFactory.generateCertificate(ByteArrayInputStream(der)) as? X509Certificate
+            } catch (e: Exception) {
+                null
+            }
+        }
+    }
+
+    /**
+     * Every PEM block of [path] must be a parseable X.509 certificate, and at
+     * least one block is required. Used for a subscription server CA bundle.
+     */
+    fun validateCertificateBundle(path: String): Boolean {
+        val blocks = readPemBlocks(path, CERTIFICATE_BLOCKS)
+        if (blocks.isEmpty()) return false
+        return try {
+            val certificateFactory = CertificateFactory.getInstance("X.509")
+            blocks.all { der ->
+                certificateFactory.generateCertificate(ByteArrayInputStream(der)) is X509Certificate
+            }
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /**
+     * Validate a private key that will be handed to the TLS stack (PKCS#8 or a
+     * PKCS#1 RSA key). Encrypted keys and SEC1 EC keys are rejected.
+     */
+    fun validatePrivateKeyForFetch(path: String): Boolean {
+        val text = readPemText(path) ?: return false
+        if (isUnsupportedPrivateKey(text)) return false
+        val pkcs1 = readPemBlocksFromText(text, listOf("RSA PRIVATE KEY")).firstOrNull()
+        if (pkcs1 != null) {
+            return canParse("RSA", wrapPkcs1RsaAsPkcs8(pkcs1))
+        }
+        val pkcs8 = readPemBlocksFromText(text, listOf("PRIVATE KEY")).firstOrNull() ?: return false
+        return canParse("RSA", pkcs8) || canParse("EC", pkcs8)
+    }
+
+    internal fun isUnsupportedPrivateKey(text: String): Boolean =
+        text.contains("-----BEGIN ENCRYPTED PRIVATE KEY-----") ||
+            text.contains("-----BEGIN EC PRIVATE KEY-----") ||
+            text.contains("Proc-Type: 4,ENCRYPTED")
+
+    private fun canParse(algorithm: String, der: ByteArray): Boolean {
+        return try {
+            KeyFactory.getInstance(algorithm).generatePrivate(PKCS8EncodedKeySpec(der))
+            true
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /**
+     * Wrap a PKCS#1 RSA private key in a PKCS#8 `PrivateKeyInfo` so the JCA can
+     * parse it. The output is `SEQUENCE { INTEGER 0, AlgorithmIdentifier
+     * rsaEncryption, OCTET STRING key }`.
+     */
+    internal fun wrapPkcs1RsaAsPkcs8(pkcs1: ByteArray): ByteArray {
+        val version = byteArrayOf(0x02, 0x01, 0x00)
+        val rsaAlgorithmIdentifier = byteArrayOf(
+            0x30, 0x0d, 0x06, 0x09,
+            0x2a, 0x86.toByte(), 0x48, 0x86.toByte(), 0xf7.toByte(), 0x0d, 0x01, 0x01, 0x01,
+            0x05, 0x00
+        )
+        val body = version + rsaAlgorithmIdentifier + derElement(0x04, pkcs1)
+        return derElement(0x30, body)
+    }
+
+    private fun derElement(tag: Int, content: ByteArray): ByteArray {
+        val length = content.size
+        val lengthBytes = when {
+            length < 0x80 -> byteArrayOf(length.toByte())
+            length <= 0xff -> byteArrayOf(0x81.toByte(), length.toByte())
+            length <= 0xffff -> byteArrayOf(0x82.toByte(), (length shr 8).toByte(), length.toByte())
+            else -> byteArrayOf(
+                0x83.toByte(),
+                (length shr 16).toByte(),
+                (length shr 8).toByte(),
+                length.toByte()
+            )
+        }
+        return byteArrayOf(tag.toByte()) + lengthBytes + content
+    }
+
+    private fun readPem(path: String, labels: List<String>): ByteArray? =
+        readPemBlocks(path, labels).firstOrNull()
+
+    private const val MAX_PEM_BYTES = 1048576L
+    private val CERTIFICATE_BLOCKS = listOf("CERTIFICATE")
+    private val PRIVATE_KEY_BLOCKS = listOf("PRIVATE KEY", "RSA PRIVATE KEY", "EC PRIVATE KEY")
+
+    private fun queryDisplayName(context: Context, uri: Uri): String? {
+        return try {
+            context.contentResolver.query(
+                uri,
+                arrayOf(OpenableColumns.DISPLAY_NAME),
+                null,
+                null,
+                null
+            )?.use { cursor ->
+                if (!cursor.moveToFirst()) return@use null
+                val index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
+                if (index < 0) null else cursor.getString(index)
+            }
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private fun sanitizeFileName(name: String): String {
+        val sanitized = unsafeNameChars.replace(name.trim(), "_").trim('.', '_')
+        val capped = if (sanitized.length > 64) sanitized.take(64) else sanitized
+        return capped.ifBlank { "cert" }
+    }
+}
