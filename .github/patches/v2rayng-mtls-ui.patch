+package com.v2ray.ang.handler
+
+import android.content.Context
+import android.net.Uri
+import android.provider.OpenableColumns
+import android.util.Base64
+import com.v2ray.ang.util.Utils
+import java.io.ByteArrayInputStream
+import java.io.File
+import java.security.cert.CertificateFactory
+import java.security.cert.X509Certificate
+import java.util.UUID
+
+/**
+ * Imports and manages mTLS certificate files for the server editor.
+ *
+ * Files are copied into the app private directory
+ * (`Utils.userAssetPath(context)/mtls`) so that the persisted absolute paths stay
+ * readable after the SAF permission grant is gone.
+ */
+object MtlsCertificateManager {
+    const val USAGE_CLIENT = "client"
+    const val USAGE_CLIENT_AUTHORITY = "client_authority"
+
+    /** Which field of an [com.v2ray.ang.dto.entities.MtlsCertificateEntry] a file belongs to. */
+    const val KIND_CERT = "cert"
+    const val KIND_KEY = "key"
+
+    data class ImportedFile(val path: String, val displayName: String)
+
+    private val unsafeNameChars = Regex("[^A-Za-z0-9._-]")
+
+    /**
+     * Copy the file selected by [uri] into the app private mTLS directory.
+     *
+     * @return the absolute destination path plus the original display name, or
+     *         `null` when the file cannot be copied.
+     */
+    fun importFile(context: Context, uri: Uri): ImportedFile? {
+        val displayName = queryDisplayName(context, uri)
+            ?: uri.lastPathSegment?.substringAfterLast('/')
+            ?: ""
+        val safeName = sanitizeFileName(displayName)
+
+        val baseDir = Utils.userAssetPath(context)
+        if (baseDir.isBlank()) return null
+        val dir = File(baseDir, "mtls")
+        if (!dir.isDirectory && !dir.mkdirs()) return null
+        if (!dir.isDirectory) return null
+
+        val destination = File(dir, "${UUID.randomUUID()}-$safeName")
+        return try {
+            val input = context.contentResolver.openInputStream(uri) ?: return null
+            input.use { source ->
+                destination.outputStream().use { output ->
+                    source.copyTo(output)
+                }
+            }
+            if (destination.length() <= 0L) {
+                destination.delete()
+                null
+            } else {
+                ImportedFile(destination.absolutePath, displayName.ifBlank { safeName })
+            }
+        } catch (e: Exception) {
+            destination.delete()
+            null
+        }
+    }
+
+    /**
+     * Delete a previously imported file, but only when it lives directly under
+     * the app private mTLS directory. Any error is ignored.
+     */
+    fun deleteQuietly(context: Context, path: String) {
+        if (path.isBlank()) return
+        try {
+            val baseDir = Utils.userAssetPath(context)
+            if (baseDir.isBlank()) return
+            val mtlsDir = File(baseDir, "mtls").canonicalFile
+            val target = File(path).canonicalFile
+            if (target.parentFile == mtlsDir && target.exists()) {
+                target.delete()
+            }
+        } catch (e: Exception) {
+            // Best effort: never let cleanup break the editor.
+        }
+    }
+
+    /**
+     * A file is usable when the path is non-blank, points to a regular file and
+     * the file is not empty.
+     */
+    fun isValidFile(path: String): Boolean {
+        if (path.isBlank()) return false
+        return try {
+            val file = File(path)
+            file.isFile && file.length() > 0L
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /**
+     * Best-effort PEM validation for a certificate file. When [requireCa] is
+     * true the certificate must carry the CA basic constraint.
+     */
+    fun validateCertificate(path: String, requireCa: Boolean): Boolean {
+        val der = readPem(path, CERTIFICATE_BLOCKS) ?: return false
+        return try {
+            val certificate = CertificateFactory.getInstance("X.509")
+                .generateCertificate(ByteArrayInputStream(der)) as? X509Certificate
+                ?: return false
+            !requireCa || certificate.basicConstraints >= 0
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    /**
+     * Best-effort PEM validation for a private key. PKCS#8 and the classic
+     * PKCS#1/EC armored forms are accepted; the core performs the real parse.
+     */
+    fun validatePrivateKey(path: String): Boolean = readPem(path, PRIVATE_KEY_BLOCKS) != null
+
+    private fun readPem(path: String, labels: List<String>): ByteArray? {
+        if (path.isBlank()) return null
+        val file = File(path)
+        if (!file.isFile || file.length() <= 0L || file.length() > MAX_PEM_BYTES) return null
+        val text = try {
+            file.readText()
+        } catch (e: Exception) {
+            return null
+        }
+        for (label in labels) {
+            val begin = "-----BEGIN $label-----"
+            val end = "-----END $label-----"
+            val start = text.indexOf(begin)
+            if (start < 0) continue
+            val stop = text.indexOf(end, start + begin.length)
+            if (stop < 0) continue
+            val body = text.substring(start + begin.length, stop).replace(Regex("\\s"), "")
+            val decoded = try {
+                Base64.decode(body, Base64.DEFAULT)
+            } catch (e: Exception) {
+                null
+            }
+            if (decoded != null && decoded.isNotEmpty()) return decoded
+        }
+        return null
+    }
+
+    private const val MAX_PEM_BYTES = 1048576L
+    private val CERTIFICATE_BLOCKS = listOf("CERTIFICATE")
+    private val PRIVATE_KEY_BLOCKS = listOf("PRIVATE KEY", "RSA PRIVATE KEY", "EC PRIVATE KEY")
+
+    private fun queryDisplayName(context: Context, uri: Uri): String? {
+        return try {
+            context.contentResolver.query(
+                uri,
+                arrayOf(OpenableColumns.DISPLAY_NAME),
+                null,
+                null,
+                null
+            )?.use { cursor ->
+                if (!cursor.moveToFirst()) return@use null
+                val index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
+                if (index < 0) null else cursor.getString(index)
+            }
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private fun sanitizeFileName(name: String): String {
+        val sanitized = unsafeNameChars.replace(name.trim(), "_").trim('.', '_')
+        val capped = if (sanitized.length > 64) sanitized.take(64) else sanitized
+        return capped.ifBlank { "cert" }
+    }
+}
